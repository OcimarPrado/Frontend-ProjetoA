T.pt={};$$("[data-i]").forEach(e=>T.pt[e.dataset.i]=e.textContent);
const LANGS={pt:"pt-BR",en:"en",es:"es"},MSG={pt:"Olá! Quero um site para o meu negócio.",en:"Hi! I'd like a website for my business.",es:"¡Hola! Quiero un sitio web para mi negocio."};
const TERM={pt:["Criando seu site...","Ajustando para celular","Configurando domínio e SSL","Ativando backup diário","Publicando","No ar em 7 dias","Manutenção mensal ativa"],
en:["Building your site...","Tuning for mobile","Setting up domain and SSL","Enabling daily backup","Publishing","Live in 7 days","Monthly maintenance active"],
es:["Creando tu sitio...","Ajustando para móvil","Configurando dominio y SSL","Activando copia diaria","Publicando","En línea en 7 días","Mantenimiento mensual activo"]};
const MOTION=document.documentElement.classList.contains("js");
function setLang(l){
  const d=T[l];document.documentElement.lang=LANGS[l];
  $$("[data-i]").forEach(e=>e.textContent=d[e.dataset.i]);
  $$(".lang button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.l===l));
  $$(".wa-link").forEach(a=>a.href=`https://wa.me/${WHATS}?text=${encodeURIComponent(MSG[l])}`);
  try{localStorage.setItem("nayco-lang",l)}catch(e){}
  runTerm(l);animH1();tagAll();
}
$$(".lang button").forEach(b=>b.onclick=()=>setLang(b.dataset.l));
$("#yr").textContent=new Date().getFullYear();
const hd=$("header"),mb=$(".mb");
mb.onclick=()=>{const o=hd.classList.toggle("open");mb.setAttribute("aria-expanded",o)};
$$("nav ul a").forEach(a=>a.onclick=()=>{hd.classList.remove("open");mb.setAttribute("aria-expanded",false)});
let termTimer;
function runTerm(l){
  clearTimeout(termTimer);const L=TERM[l];
  const lines=[`<span class="dim">$</span> nayco novo-site seunegocio.com.br`,`<span class="dim">›</span> ${L[0]}`,`<span class="ok">✓</span> ${L[1]}`,`<span class="ok">✓</span> ${L[2]}`,`<span class="ok">✓</span> ${L[3]}`,`<span class="or">›</span> ${L[4]}`,`<span class="ok">● ${L[5]}</span>`,`<span class="ok">✓</span> ${L[6]}`];
  const el=$("#term");
  if(!MOTION){el.innerHTML=lines.join("\n");return}
  let i=0;el.innerHTML="";
  (function next(){
    if(i>=lines.length){el.insertAdjacentHTML("beforeend","\n<span class='caret'></span>");return}
    el.insertAdjacentHTML("beforeend",(i?"\n":"")+lines[i++]);
    termTimer=setTimeout(next,i===1?500:650);
  })();
}
document.body.insertAdjacentHTML("afterbegin",'<div id="bar"></div>');
const io=("IntersectionObserver" in window)?new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target);setTimeout(()=>e.target.style.setProperty("--d","0s"),1600)}}),{threshold:.15,rootMargin:"0px 0px -6% 0px"}):null;
function tag(sel,type,step,base){$$(sel).forEach((e,i)=>{if(e.dataset.a)return;e.dataset.a=type;e.style.setProperty("--d",((base||0)+i*(step||0))+"s")})}
function tagAll(){
  if(!MOTION)return;
  tag(".hero .lead","up",0,.45);tag(".hero .cta","up",0,.6);tag(".term","right",0,.35);
  tag("#sobre h2","clip");tag(".final h2","zoom");tag(".lead-form","up",0,.1);tag("section:not(.hero) h2","up");tag("section:not(.hero) .lead","up",0,.12);
  tag(".svc article","flip",.15);tag(".q","up",.12);tag(".plan","zoom",.15);tag(".host","zoom");tag(".work figure","zoom",.1);tag(".about li","right",.12);
  $$("[data-a]:not(.in)").forEach(e=>io?io.observe(e):e.classList.add("in"));
}
function animH1(){
  if(!MOTION)return;const h=$("h1");
  h.innerHTML=h.textContent.split(" ").map((w,i)=>`<span class="w" style="animation-delay:${.1+i*.09}s">${w}</span>`).join(" ");
}
if(MOTION){
  let tick=false;
  addEventListener("scroll",()=>{if(tick)return;tick=true;requestAnimationFrame(()=>{tick=false;const m=document.documentElement.scrollHeight-innerHeight;$("#bar").style.transform=`scaleX(${m>0?scrollY/m:0})`;hd.classList.toggle("sm",scrollY>40)})},{passive:true});
  const hero=$(".hero");
  hero.addEventListener("pointermove",e=>{const r=hero.getBoundingClientRect();hero.style.setProperty("--mx",(e.clientX-r.left)+"px");hero.style.setProperty("--my",(e.clientY-r.top)+"px")});
}
if(MOTION&&matchMedia("(hover:hover)").matches){
  $$(".svc article,.work figure,.host,.plan").forEach(el=>{el.classList.add("spot");el.addEventListener("pointermove",e=>{const r=el.getBoundingClientRect();el.style.setProperty("--x",(e.clientX-r.left)+"px");el.style.setProperty("--y",(e.clientY-r.top)+"px")})});
  $$(".work figure").forEach(f=>{const a=$("a",f);f.addEventListener("pointermove",e=>{const r=f.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;a.style.setProperty("--ry",(x*10)+"deg");a.style.setProperty("--rx",(-y*10)+"deg")});f.addEventListener("pointerleave",()=>{a.style.setProperty("--rx","0deg");a.style.setProperty("--ry","0deg")})});
  $$(".btn").forEach(b=>{b.addEventListener("pointermove",e=>{const r=b.getBoundingClientRect();b.style.setProperty("--tx",((e.clientX-r.left-r.width/2)*.2)+"px");b.style.setProperty("--ty",((e.clientY-r.top-r.height/2)*.3)+"px")});b.addEventListener("pointerleave",()=>{b.style.setProperty("--tx","0px");b.style.setProperty("--ty","0px")})});
}
$("#lead").addEventListener("submit",e=>{
  e.preventDefault();
  const f=e.target,v=n=>f.elements[n].value.trim(),s=n=>T.pt[f.elements[n].selectedOptions[0].dataset.i];
  const L=[["Nome",v("nome")],["Negócio",v("negocio")],["Tipo de site",s("tipo")],["Situação atual",s("tem")],["Objetivo",s("meta")],["Prazo",s("prazo")],["Logo e fotos",s("midia")],["Referências",v("ref")],["Observações",v("obs")]].filter(x=>x[1]);
  const msg="Olá! Vim pelo site da Nayco e quero um orçamento.\n\n"+L.map(x=>`*${x[0]}:* ${x[1]}`).join("\n");
  const u=`https://wa.me/${WHATS}?text=${encodeURIComponent(msg)}`;
  window.open(u,"_blank","noopener")||(location.href=u);
});
let saved=null;try{saved=localStorage.getItem("nayco-lang")}catch(e){}
setLang(T[saved]?saved:"pt");
